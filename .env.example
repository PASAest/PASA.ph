# Copy this file to .env and fill in from Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Password you set in supabase/seed-users.sql, for `npm run seed`. Wrap it in quotes if it contains #
SEED_PASSWORD=
