{
  "expo": {
    "name": "PASA",
    "slug": "pasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pasa.campus"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2FBFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pasa.campus",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "PASA",
      "shortName": "PASA",
      "themeColor": "#87CEEB",
      "backgroundColor": "#F2FBFF",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#F2FBFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PASA uses your photos for listing pictures and your profile photo.",
          "cameraPermission": "PASA uses your camera to take photos of items you list and for your profile picture."
        }
      ],
      "expo-video"
    ],
    "scheme": "pasa",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "23e2e3f3-7c4a-4de7-9770-95a8f77e465d"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/23e2e3f3-7c4a-4de7-9770-95a8f77e465d"
    }
  }
}
